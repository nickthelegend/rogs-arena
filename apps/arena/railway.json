{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter @apps/arena build",
    "watchPatterns": ["apps/arena/**", "packages/**", "programs/rogs-arena/src/**", "package.json", "bun.lock"]
  },
  "deploy": {
    "startCommand": "bun run --filter @apps/arena start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
