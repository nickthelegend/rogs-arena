{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/arena/Dockerfile",
    "watchPatterns": ["apps/arena/**", "packages/**", "package.json", "bun.lock"]
  },
  "deploy": {
    "startCommand": "bun run apps/arena/src/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
