{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter @apps/web build",
    "watchPatterns": ["apps/web/**", "packages/**", "package.json", "bun.lock"]
  },
  "deploy": {
    "startCommand": "bun run --filter @apps/web start"
  }
}
